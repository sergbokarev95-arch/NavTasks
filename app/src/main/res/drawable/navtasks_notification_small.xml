<?xml version="1.0" encoding="utf-8"?>
<!-- NavTasks notification-only glyph. 24dp monochrome, transparent canvas.
     Based on the app's layered task-card/check motif; no launcher tile or alpha
     overlays. Android/MagicOS applies the system tint to its small icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Rear task card: visible top and right edges, not a solid badge. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8.4,3.1 H18.4 Q20.4,3.1 20.4,5.1 V16.4" />
    <!-- Front rounded task card. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5.7,6.5 H15.4 Q17.5,6.5 17.5,8.6 V19 Q17.5,21.1 15.4,21.1 H5.7 Q3.6,21.1 3.6,19 V8.6 Q3.6,6.5 5.7,6.5 Z" />
    <!-- Clear NavTasks completion check; deliberately larger at 24dp. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6.8,13.7 L9.5,16.4 L14.5,11.5" />
</vector>
