<?xml version="1.0" encoding="utf-8"?>
<!-- Wide two-column layout only when >=350dp; narrow wide widgets use compact XML. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/navtasks_widget_bg"
    android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/nav_widget_title"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Сегодня · 7 ноя" android:textColor="#F2F8FF"
            android:textSize="13sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/nav_widget_progress"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0/0" android:textColor="#69D4BE" android:textSize="14sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/nav_widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout android:id="@+id/nav_widget_row_one"
                android:paddingRight="8dp"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="27dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="visible">
                <TextView android:id="@+id/nav_widget_check_one"
                    android:layout_width="29dp" android:layout_height="28dp"
                    android:gravity="center" android:text="○"
                    android:textColor="#69D4BE" android:textSize="21sp" />
                <TextView android:id="@+id/nav_widget_task_one"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Задача" android:textColor="#F2F8FF"
                    android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_widget_row_two"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="27dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="visible">
                <TextView android:id="@+id/nav_widget_check_two"
                    android:layout_width="29dp" android:layout_height="28dp"
                    android:gravity="center" android:text="○"
                    android:textColor="#69D4BE" android:textSize="21sp" />
                <TextView android:id="@+id/nav_widget_task_two"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Задача" android:textColor="#F2F8FF"
                    android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout android:id="@+id/nav_widget_row_three"
                android:paddingRight="8dp"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="27dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <TextView android:id="@+id/nav_widget_check_three"
                    android:layout_width="29dp" android:layout_height="28dp"
                    android:gravity="center" android:text="○"
                    android:textColor="#69D4BE" android:textSize="21sp" />
                <TextView android:id="@+id/nav_widget_task_three"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Задача" android:textColor="#F2F8FF"
                    android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_widget_row_four"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="27dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <TextView android:id="@+id/nav_widget_check_four"
                    android:layout_width="29dp" android:layout_height="28dp"
                    android:gravity="center" android:text="○"
                    android:textColor="#69D4BE" android:textSize="21sp" />
                <TextView android:id="@+id/nav_widget_task_four"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Задача" android:textColor="#F2F8FF"
                    android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/nav_widget_status"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:maxLines="1"
            android:ellipsize="end" android:text="Все задачи"
            android:textColor="#AFC4D8" android:textSize="11sp" />
        <TextView android:id="@+id/nav_widget_secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:textColor="#FFB1A6"
            android:textSize="10sp" android:text="Пропущено: 2"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:background="@drawable/navtasks_widget_missed_dark" />
    </LinearLayout>
</LinearLayout>
