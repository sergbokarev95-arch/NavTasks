<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only 4×2 summary, consistent Apple-like type hierarchy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/navtasks_widget_bg_dark"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/nav_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сегодня"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/nav_widget_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="116dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nav_widget_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:fontFamily="sans-serif-medium"
                android:textSize="39sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/nav_widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nav_widget_detail_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/nav_widget_detail_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/nav_widget_detail_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Percentage belongs to progress, not the date/title header. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ProgressBar
            android:id="@+id/nav_widget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="5dp"
            android:layout_marginEnd="12dp"
            android:progressTint="#007AFF"
            android:progressBackgroundTint="#406F7883" />
        <TextView
            android:id="@+id/nav_widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/nav_widget_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/navtasks_widget_missed_dark"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
