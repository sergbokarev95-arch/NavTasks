<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only 2×2 statistics. The entire surface opens NavTasks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="fill"
    android:background="@drawable/navtasks_widget_bg_light"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/nav_widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Сегодня"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/nav_widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Flexible space adapts to HONOR's taller-than-square 2×2 cell. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/nav_widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0/0"
        android:fontFamily="sans-serif-medium"
        android:textSize="43sp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/nav_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <ProgressBar
        android:id="@+id/nav_widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:progressTint="#007AFF"
        android:progressBackgroundTint="#406F7883" />

    <TextView
        android:id="@+id/nav_widget_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/navtasks_widget_missed_light"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
