<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen, continuous PDF pages rendered by AndroidX PDF beta (experimental). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_pdf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/nav_pdf_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/nav_pdf_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:text="‹"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/nav_pdf_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:textSize="17sp" />
        <ImageButton
            android:id="@+id/nav_pdf_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Search PDF"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_search" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/nav_pdf_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
